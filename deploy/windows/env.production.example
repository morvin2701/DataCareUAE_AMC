# DcAMC backend — production .env for C:\DcAMC\app\backend\.env on DataCare's server (the SQL Server machine).
# The frontend runs on Vercel; only this API runs here. Copy this file there, fill every value, never commit it.

NODE_ENV=production
PORT=4100
# the Vercel site the team opens (CORS) — e.g. https://dcamc.vercel.app or your own domain on Vercel
CORS_ORIGIN=https://dcamc.vercel.app
# where this API is reachable from the internet (Google Drive redirect, links in messages) — the IIS host name below
APP_BASE_URL=https://amc-api.datacarewebuae.com

# the one database, DcAmc, on this SQL Server (created by the app on first start; the login needs dbcreator, or make it first)
AMC_DB_SERVER=127.0.0.1
AMC_DB_PORT=1433
AMC_DB_NAME=DcAmc
AMC_DB_USER=dcuae_app
AMC_DB_PASSWORD=
AMC_DB_AUTH=sql

# 32 bytes base64 each — PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
# Link keys, SMTP and WhatsApp secrets are encrypted with AMC_ENCRYPTION_KEY — never change it once customers are linked.
AMC_ENCRYPTION_KEY=
SESSION_SECRET=

# the first owner login, made once when AMC_USER is empty (change the password after the first sign-in)
OWNER_LOGIN=msv
OWNER_NAME=Morvin
OWNER_PASSWORD=

# backups: the folder SQL Server writes into (this machine); the SQL Server service account needs write access there
BACKUP_PATH=C:\AmcBkps
# Google Drive backup — this app's own OAuth client; add APP_BASE_URL/api/backup/drive/callback as a redirect URI
GDRIVE_OAUTH_CLIENT_ID=
GDRIVE_OAUTH_CLIENT_SECRET=
