# DcAMC backend — development .env (copy to backend/.env). Production: deploy/windows/env.production.example
NODE_ENV=development
PORT=4100
CORS_ORIGIN=http://localhost:5180
APP_BASE_URL=http://localhost:5180

# the one database, DcAmc, on DataCare's SQL Server (created by the app on first start)
AMC_DB_SERVER=103.49.124.50
AMC_DB_PORT=1433
AMC_DB_NAME=DcAmc
AMC_DB_USER=
AMC_DB_PASSWORD=
AMC_DB_AUTH=sql

# 32 bytes base64 — link keys and SMTP / Drive secrets are encrypted with this. Never change it once set.
AMC_ENCRYPTION_KEY=
SESSION_SECRET=

# the first owner login, created once when AMC_USER is empty
OWNER_LOGIN=msv
OWNER_NAME=Morvin
OWNER_PASSWORD=

# backups: folder SQL Server writes into (on the SQL Server machine)
BACKUP_PATH=C:\AmcBkps
# Google Drive backup — OAuth client; redirect URI = APP_BASE_URL/api/backup/drive/callback
GDRIVE_OAUTH_CLIENT_ID=
GDRIVE_OAUTH_CLIENT_SECRET=
